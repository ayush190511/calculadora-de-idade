---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ContactForm } from '../components/ContactForm';
import SEOSchema from '../components/SEOSchema.astro';
import { Mail, HelpCircle, ExternalLink, ShieldCheck } from 'lucide-react';
import '../styles/global.css';

const title = "Contato — Calculadora de Idade (calculadoradeidade.com)";
const description = "Fale conosco! Tem alguma dúvida sobre as calculadoras de idade, sugestão de melhoria ou relato de erro? Envie-nos uma mensagem.";
const canonicalUrl = "https://calculadoradeidade.com/contato";
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Hreflang Tags -->
    <link rel="alternate" hreflang="pt-BR" href={canonicalUrl} />
    <link rel="alternate" hreflang="pt-PT" href={canonicalUrl} />
    <link rel="alternate" hreflang="pt-AO" href={canonicalUrl} />
    <link rel="alternate" hreflang="pt-MZ" href={canonicalUrl} />
    <link rel="alternate" hreflang="pt" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Calculadora de Idade" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://calculadoradeidade.com/og-image.png" />

    <!-- JSON-LD Structured Data -->
    <SEOSchema page="contact" title={title} description={description} canonicalUrl={canonicalUrl} />

    <script is:inline>
      (function() {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark') {
          document.documentElement.classList.add('dark');
        } else if (saved === 'light') {
          document.documentElement.classList.remove('dark');
        } else {
          if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.classList.add('dark');
          }
        }
      })();
    </script>
  </head>

  <body class="min-h-screen bg-[var(--canvas)] text-[var(--ink-primary)] selection:bg-[var(--ink-primary)] selection:text-[var(--canvas-card)] flex flex-col justify-between hero-mesh-bg transition-colors">
    <div>
      <Header />

      <main class="max-w-4xl mx-auto px-4 sm:px-6 pt-8 pb-16 space-y-8">
        <div class="text-center space-y-3">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--canvas-inset)] border border-[var(--hairline)] text-xs font-semibold text-[#10b981]">
            <Mail className="w-3.5 h-3.5" />
            <span>Canal Direto de Atendimento</span>
          </div>
          <h1 class="text-2xl sm:text-4xl font-black tracking-tight text-[var(--ink-primary)]">
            Entre em Contato Conosco
          </h1>
          <p class="text-xs sm:text-sm text-[var(--ink-body)] max-w-xl mx-auto leading-relaxed">
            Sua opinião é fundamental para continuarmos aprimorando as ferramentas do portal. Envie suas dúvidas, sugestões ou feedbacks abaixo.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="md:col-span-2">
            <ContactForm client:load />
          </div>

          <div class="space-y-4">
            <div class="bg-[var(--canvas-card)] border border-[var(--hairline)] rounded-2xl p-5 space-y-2">
              <h3 class="text-sm font-bold text-[var(--ink-primary)]">Tempo de Resposta</h3>
              <p class="text-xs text-[var(--ink-body)] leading-relaxed">
                Respondemos a todas as mensagens enviadas em até 24 a 48 horas úteis.
              </p>
            </div>

            <div class="bg-[var(--canvas-card)] border border-[var(--hairline)] rounded-2xl p-5 space-y-2">
              <h3 class="text-sm font-bold text-[var(--ink-primary)]">Sugestões de Recursos</h3>
              <p class="text-xs text-[var(--ink-body)] leading-relaxed">
                Gostaria de ver uma calculadora específica para sua área ou necessidade? Conte para a nossa equipe!
              </p>
            </div>
          </div>
        </div>
      </main>
    </div>

    <Footer />
  </body>
</html>
