---
import Header from '../components/Header.astro';
import { NormalAgeMode } from '../components/modes/NormalAgeMode';
import SEOContent from '../components/SEOContent.astro';
import SEOSchema from '../components/SEOSchema.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const title = "Calculadora de Idade Online — Calcular Idade Exata por Data de Nascimento";
const description = "Calculadora de idade online grátis por data de nascimento. Descubra quantos anos você tem em anos, meses, dias, horas e segundos ao vivo. Ferramenta precisa para calcular idade cronológica, gestacional, aposentadoria e diferença entre datas.";
const canonicalUrl = "https://calculadoradeidade.com/";
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta 
      name="keywords" 
      content="calculadora de idade, calculadora idade, quantos anos eu tenho, google quantos anos eu tenho, minha idade, calcular idade, idade, calculo de idade, calculadora idade gestacional, calculadora de idade gestacional, calculadora de idade entre datas, calculadora idade corrigida, calculadora idade corrigida prematuro, calculadora de idade corrigida, calculadora de idade atual, calculadora de idade e meses, calcular data de nascimento, anos meses e dias" 
    />
    <meta name="author" content="Calculadora de Idade" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Hreflang Tags para Português (Brasil, Portugal, Angola, Moçambique e Lusofonia) -->
    <link rel="alternate" hreflang="pt-BR" href="https://calculadoradeidade.com/" />
    <link rel="alternate" hreflang="pt-PT" href="https://calculadoradeidade.com/" />
    <link rel="alternate" hreflang="pt-AO" href="https://calculadoradeidade.com/" />
    <link rel="alternate" hreflang="pt-MZ" href="https://calculadoradeidade.com/" />
    <link rel="alternate" hreflang="pt" href="https://calculadoradeidade.com/" />
    <link rel="alternate" hreflang="x-default" href="https://calculadoradeidade.com/" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Calculadora de Idade (calculadoradeidade.com)" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://calculadoradeidade.com/og-image.png" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:locale:alternate" content="pt_PT" />

    <!-- Twitter Card -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="https://calculadoradeidade.com/og-image.png" />

    <!-- JSON-LD Structured Data -->
    <SEOSchema page="home" title={title} description={description} canonicalUrl={canonicalUrl} />

    <!-- Theme Initialization Script -->
    <script is:inline>
      (function() {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark') {
          document.documentElement.classList.add('dark');
        } else if (saved === 'light') {
          document.documentElement.classList.remove('dark');
        } else {
          if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.classList.add('dark');
          }
        }
      })();
    </script>
  </head>

  <body class="min-h-screen bg-[var(--canvas)] text-[var(--ink-primary)] selection:bg-[var(--ink-primary)] selection:text-[var(--canvas-card)] flex flex-col justify-between hero-mesh-bg transition-colors">
    <div>
      <Header />

      <main class="max-w-5xl mx-auto px-4 sm:px-6 pt-6 sm:pt-8 pb-16 space-y-6 sm:space-y-8">
        <!-- Calculadora Principal de Idade -->
        <section id="calculator">
          <NormalAgeMode client:load />
        </section>

        <!-- Seção SEO e FAQ Rico -->
        <SEOContent page="home" />
      </main>
    </div>

    <Footer />
  </body>
</html>
