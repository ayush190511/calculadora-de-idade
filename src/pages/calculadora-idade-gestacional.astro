---
import Header from '../components/Header.astro';
import { BabyAgeMode } from '../components/modes/BabyAgeMode';
import SEOContent from '../components/SEOContent.astro';
import SEOSchema from '../components/SEOSchema.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const title = "Calculadora de Idade Gestacional, Idade do Bebê e Idade Corrigida";
const description = "Calculadora de idade gestacional e idade do bebê em semanas, meses e dias. Inclui cálculo de idade corrigida para bebês prematuros e acompanhamento de mesversário.";
const canonicalUrl = "https://calculadoradeidade.com/calculadora-idade-gestacional";
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta 
      name="keywords" 
      content="calculadora de idade gestacional, calculadora de idade corrigida, idade do bebe, calculadora idade bebe, semanas de gestação, idade corrigida prematuro, calcular semanas de vida do bebe" 
    />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Hreflang Tags -->
    <link rel="alternate" hreflang="pt-BR" href={canonicalUrl} />
    <link rel="alternate" hreflang="pt-PT" href={canonicalUrl} />
    <link rel="alternate" hreflang="pt-AO" href={canonicalUrl} />
    <link rel="alternate" hreflang="pt-MZ" href={canonicalUrl} />
    <link rel="alternate" hreflang="pt" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Calculadora de Idade" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://calculadoradeidade.com/og-image.png" />

    <!-- JSON-LD Structured Data -->
    <SEOSchema page="baby" title={title} description={description} canonicalUrl={canonicalUrl} />

    <script is:inline>
      (function() {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark') {
          document.documentElement.classList.add('dark');
        } else if (saved === 'light') {
          document.documentElement.classList.remove('dark');
        } else {
          if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.classList.add('dark');
          }
        }
      })();
    </script>
  </head>

  <body class="min-h-screen bg-[var(--canvas)] text-[var(--ink-primary)] selection:bg-[var(--ink-primary)] selection:text-[var(--canvas-card)] flex flex-col justify-between hero-mesh-bg transition-colors">
    <div>
      <Header />

      <main class="max-w-5xl mx-auto px-4 sm:px-6 pt-6 sm:pt-8 pb-16 space-y-6 sm:space-y-8">
        <section id="calculator">
          <BabyAgeMode client:load />
        </section>

        <SEOContent page="baby" />
      </main>
    </div>

    <Footer />
  </body>
</html>
