---
---

<footer class="mt-20 border-t border-[var(--hairline)] bg-[var(--canvas-card)] py-12 text-xs text-[var(--ink-mute)] transition-colors relative">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 space-y-6">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pb-6 border-b border-[var(--hairline)]">
      <div class="flex items-center gap-2">
        <span class="font-bold text-[var(--ink-primary)]">Calculadora de Idade</span>
        <span class="font-mono text-[11px] text-[var(--ink-mute)]">calculadoradeidade.com</span>
      </div>

      <div class="flex flex-wrap items-center gap-4 text-xs">
        <a href="/sobre" class="hover:text-[var(--ink-primary)] transition">Sobre Nós</a>
        <a href="/contato" class="hover:text-[var(--ink-primary)] transition">Contato</a>
        <a href="/politica-de-privacidade" class="hover:text-[var(--ink-primary)] transition">Política de Privacidade</a>
        <a href="/termos-de-uso" class="hover:text-[var(--ink-primary)] transition">Termos de Uso</a>
        <a href="/#faq" class="hover:text-[var(--ink-primary)] transition">Dúvidas Frequentes (FAQ)</a>
      </div>
    </div>

    <div class="space-y-2 text-[11px] text-[var(--ink-mute)] leading-relaxed">
      <p>
        <strong>Aviso Legal:</strong> A Calculadora de Idade (calculadoradeidade.com) é uma plataforma online independente para cálculo de idade cronológica exata, idade gestacional e de bebês, diferença entre datas, aposentadoria, idade canina e elegibilidade etária em concursos públicos. Todas as informações e ferramentas são fornecidas para fins informativos e de utilidade pública.
      </p>
      <p>© {new Date().getFullYear()} Calculadora de Idade (calculadoradeidade.com). Todos os direitos reservados. Feito com precisão para todos os países de língua portuguesa.</p>
    </div>
  </div>

  <!-- Botão Voltar ao Topo -->
  <button
    id="scroll-to-top"
    type="button"
    aria-label="Voltar ao topo da página"
    class="fixed bottom-6 right-6 z-50 p-3 rounded-full bg-[var(--canvas-card)] border border-[var(--hairline)] text-[var(--ink-primary)] shadow-lg hover:border-[var(--ink-primary)] hover:scale-105 active:scale-95 transition-all duration-300 opacity-0 pointer-events-none translate-y-4 flex items-center justify-center cursor-pointer select-none"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
    </svg>
  </button>
</footer>

<script is:inline>
  const scrollBtn = document.getElementById('scroll-to-top');
  if (scrollBtn) {
    window.addEventListener('scroll', function() {
      if (window.scrollY > 280) {
        scrollBtn.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
        scrollBtn.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
      } else {
        scrollBtn.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
        scrollBtn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
      }
    });

    scrollBtn.addEventListener('click', function() {
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    });
  }
</script>
