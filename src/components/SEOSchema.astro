---
import GoogleAnalytics from './GoogleAnalytics.astro';

export interface Props {
  page: 'home' | 'concursos' | 'retirement' | 'dog' | 'baby' | 'datediff' | 'about' | 'contact' | 'privacy' | 'terms';
  title: string;
  description: string;
  canonicalUrl: string;
}

const { page, title, description, canonicalUrl } = Astro.props;

const isToolPage = ['home', 'concursos', 'retirement', 'dog', 'baby', 'datediff'].includes(page);

// 1. WebApplication / SoftwareApplication Schema para Calculadoras
const softwareAppSchema = isToolPage ? {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": title,
  "operatingSystem": "All",
  "applicationCategory": "UtilitiesApplication",
  "inLanguage": "pt",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "BRL"
  },
  "description": description,
  "url": canonicalUrl,
  "browserRequirements": "Requer JavaScript e HTML5."
} : null;

// 2. Organization & WebSite Schema (Página Inicial)
const websiteSchema = page === 'home' ? {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Calculadora de Idade",
  "alternateName": "Calculadora de Idade Online",
  "inLanguage": "pt",
  "url": "https://calculadoradeidade.com/",
  "publisher": {
    "@type": "Organization",
    "name": "Calculadora de Idade",
    "url": "https://calculadoradeidade.com/",
    "logo": "https://calculadoradeidade.com/Logo.png"
  }
} : null;

// 3. BreadcrumbList Schema para Páginas Internas
const breadcrumbNames: Record<string, string> = {
  concursos: "Calculadora de Idade para Concursos e Editais",
  retirement: "Calculadora de Idade para Aposentadoria",
  dog: "Calculadora de Idade de Cachorro",
  baby: "Calculadora de Idade Gestacional e Bebê",
  datediff: "Calculadora de Idade Entre Datas",
  about: "Sobre Nós",
  contact: "Contato",
  privacy: "Política de Privacidade",
  terms: "Termos de Uso"
};

const breadcrumbSchema = page !== 'home' && breadcrumbNames[page] ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Início",
      "item": "https://calculadoradeidade.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": breadcrumbNames[page],
      "item": canonicalUrl
    }
  ]
} : null;
---

<GoogleAnalytics />

{websiteSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
)}

{softwareAppSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(softwareAppSchema)} />
)}

{breadcrumbSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
)}
